<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: Arial, sans-serif;
        }
        
        .header {
            background-color: #333;
            color: white;
            padding: 20px;
            /* Фиксированная высота или min-height */
            flex-shrink: 0;
        }
        
        .footer {
            background-color: #333;
            color: white;
            padding: 20px;
            /* Фиксированная высота или min-height */
            flex-shrink: 0;
        }
        
        .content-wrapper {
            flex: 1;
            overflow: hidden;
            min-height: 0; /* Важно для Firefox */
        }
        
        .scrollable-content {
            width: 100%;
            height: 100%;
            overflow: auto;
            padding: 20px;
            background-color: #f0f0f0;
        }
        
        /* Пример контента для демонстрации прокрутки */
        .demo-content {
            width: 150vw;
            height: 150vh;
            background: repeating-linear-gradient(
                45deg,
                #e0e0e0,
                #e0e0e0 10px,
                #f5f5f5 10px,
                #f5f5f5 20px
            );
        }
    </style>
</head>
<body>
<header class="header">
    Верхний элемент (всегда виден)
</header>
    
<div class="content-wrapper">
    <div class="scrollable-content">
        <div class="demo-content">
            @RenderBody()
        </div>
    </div>
</div>
    
<footer class="footer">
    Нижний элемент (всегда виден)
</footer>
</body>
</html>