<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>PlanA - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
    <div class="container">
        <ul class="nav nav-tabs nav-tabs-custom flex-nowrap mt-2 mt-lg-0">
            <li class="nav-item">
                <button class="nav-link active" data-route="index">
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-clipboard-check me-2"></i>
                        PlanA
                    </a>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-route="assetsview">
                    <a asp-area="" asp-controller="Work" asp-action="AssetsView">
                        <i class="bi bi-box-seam me-1"></i>
                        Склад
                    </a>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-route="ordersview">
                    <a asp-area="" asp-controller="Work" asp-action="OrdersView">
                        <i class="bi bi-cart-check me-1"></i>
                        Заказы
                    </a>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-route="operationsview">
                    <a asp-area="" asp-controller="Work" asp-action="OperationsView">
                        <i class="bi bi-hammer me-1"></i>
                        Операции
                    </a>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-route="processesview">
                    <a asp-area="" asp-controller="Work" asp-action="ProcessesView">
                        <i class="bi bi-diagram-3 me-1"></i>
                        Процессы
                    </a>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-route="loadingview">
                    <a asp-area="" asp-controller="Work" asp-action="LoadingView">
                        <i class="bi bi-graph-up-arrow me-1"></i>
                        Загрузка
                    </a>
                </button>
            </li>
        </ul>
        <ul class="nav nav-tabs nav-tabs-custom flex-nowrap mt-2 mt-lg-0">
            
        </ul>
    </div>
</nav>

<main class="flex-grow-1 py-4">
<div class="container">
        @RenderBody()
    </div>
</main>

<footer class="footer-fixed">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-center gap-3 btn-group-responsive">
            <button class="btn btn-success action-btn btn-create" id="createBtn">
                <i class="bi bi-plus-circle"></i>
                Создать
            </button>
            <button class="btn btn-warning action-btn btn-edit" id="editBtn" disabled>
                <i class="bi bi-pencil-square"></i>
                Редактировать
            </button>
            <button class="btn btn-info action-btn btn-copy" id="copyBtn" disabled>
                <i class="bi bi-files"></i>
                Копировать
            </button>
            <button class="btn btn-danger action-btn btn-delete" id="deleteBtn" disabled>
                <i class="bi bi-trash"></i>
                Удалить
            </button>
        </div>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
    // Самый надежный способ - используем data-route
    function setActiveNavLink() {
        const currentPath = window.location.pathname.toLowerCase();
        const navLinks = document.querySelectorAll('.nav-tabs-custom .nav-link[data-route]');
        
        console.log('Current path:', currentPath);
        
        // Удаляем класс active у всех ссылок
        navLinks.forEach(link => {
            link.classList.remove('active');
        });
        
        // Получаем текущий route из URL
        const pathSegments = currentPath.split('/').filter(segment => segment.trim() !== '');
        const currentRoute = pathSegments.length > 0 ? pathSegments[pathSegments.length - 1] : 'index';
        
        console.log('Current route:', currentRoute);
        
        // Ищем ссылку с соответствующим data-route
        navLinks.forEach(link => {
            const route = link.getAttribute('data-route');
            if (route && currentRoute === route) {
                link.classList.add('active');
                console.log('Found active link with data-route:', route);
            }
        });
        
        // Если не нашли, проверяем главную страницу
        if (currentPath === '/' || currentPath === '/home' || currentPath === '/home/index') {
            // Здесь можно активировать ссылку на главную, если она есть
            const homeLink = document.querySelector('[data-route="index"]');
            if (homeLink) {
                homeLink.classList.add('active');
            }
        }
    }
    
    document.addEventListener('DOMContentLoaded', setActiveNavLink);
    window.addEventListener('popstate', setActiveNavLink);
</script>
</body>
</html>