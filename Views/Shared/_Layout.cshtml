<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>PlanA - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    
</head>
<body>
<header class="navbar-custom">
    <div class="container-fluid">
        <ul class="nav nav-tabs-custom">
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-clipboard-check"></i>
                    <span class="nav-text">PlanA</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="AssetsView">
                    <i class="bi bi-box-seam"></i>
                    <span class="nav-text">Склад</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="OrdersView">
                    <i class="bi bi-cart-check"></i>
                    <span class="nav-text">Заказы</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="OperationsView">
                    <i class="bi bi-tools"></i>
                    <span class="nav-text">Операции</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="ProcessesView">
                    <i class="bi bi-diagram-3"></i>
                    <span class="nav-text">Процессы</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="LoadingView">
                    <i class="bi bi-bar-chart-steps"></i>
                    <span class="nav-text">Загрузка</span>
                </a>
            </li>
        </ul>
    </div>
</header>

<div class="content-wrapper">
    <div class="scrollable-content">
        <div class="demo-content">
            @RenderBody()
        </div>
    </div>
</div>

<footer class="footer-fixed">
    <div class="action-buttons">
        <button class="btn btn-success action-btn btn-create" id="createBtn">
            <i class="bi bi-plus-circle"></i>
            <span class="btn-text">Создать</span>
        </button>
        <button class="btn btn-warning action-btn btn-edit" id="editBtn" disabled>
            <i class="bi bi-pencil-square"></i>
            <span class="btn-text">Редактировать</span>
        </button>
        <button class="btn btn-info action-btn btn-copy" id="copyBtn" disabled>
            <i class="bi bi-files"></i>
            <span class="btn-text">Копировать</span>
        </button>
        <button class="btn btn-danger action-btn btn-delete" id="deleteBtn" disabled>
            <i class="bi bi-trash"></i>
            <span class="btn-text">Удалить</span>
        </button>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>