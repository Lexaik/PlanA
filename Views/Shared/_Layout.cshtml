<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>PlanA - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/PlanA.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
<header class="navbar-custom header-fixed">
    <div class="container-fluid">
        <ul class="nav nav-tabs-custom">
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-clipboard-check me-2"></i>
                    PlanA
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="AssetsView">
                    <i class="bi bi-box-seam me-1"></i>
                    Склад
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="OrdersView">
                    <i class="bi bi-cart-check me-1"></i>
                    Заказы
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="OperationsView">
                    <i class="bi bi-hammer me-1"></i>
                    Операции
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="ProcessesView">
                    <i class="bi bi-diagram-3 me-1"></i>
                    Процессы
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="" asp-controller="Work" asp-action="LoadingView">
                    <i class="bi bi-graph-up-arrow me-1"></i>
                    Загрузка
                </a>
            </li>
        </ul>
    </div>
</header>

<div class="content-wrapper">
    <div class="scrollable-content">
        @RenderBody()
    </div>
</div>

<footer class="footer-fixed">
    <div class="action-buttons">
        <button class="btn btn-success action-btn btn-create" id="createBtn">
            <i class="bi bi-plus-circle"></i>
            Создать
        </button>
        <button class="btn btn-info action-btn btn-copy" id="copyBtn" disabled>
            <i class="bi bi-files"></i>
            Копировать
        </button>
        <button class="btn btn-warning action-btn btn-edit" id="editBtn" disabled>
            <i class="bi bi-pencil-square"></i>
            Редактировать
        </button>
        
        <button class="btn btn-danger action-btn btn-delete" id="deleteBtn" disabled>
            <i class="bi bi-trash"></i>
            Удалить
        </button>
    </div>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>