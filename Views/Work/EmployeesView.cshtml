@model IEnumerable<PlanA.Models.Employee>

@{
    ViewData["Title"] = "Список сотрудников";
}

<div class="text-center">
    <p><a asp-action="CreateEmployee">Добавить сотрудника</a></p>
    <table class="table">
        <tr><th>Фамилия</th>
            <th>Имя</th>
            <th>Отчество</th>
            <th>Дата рождения</th>
            <th>Номер телефона</th>
            <th>Адрес</th>
            <th>Профессия</th>
            <th>Заработная плата</th>
        </tr>
        @foreach (var employee in Model) {
            <tr>
                <td>@employee.Person.LastName</td>
                <td>@employee.Person.Name</td>
                <td>@employee.Person.Patronymic</td>
                <td>@employee.Person.Birthday.ToString()</td>
                <td>@employee.Person.PhoneNumber</td>
                <td>@employee.Person.Address</td>
                <td>@employee.Profession</td>
                <td>@employee.Salary</td>
            </tr>
        }
    </table>
</div>