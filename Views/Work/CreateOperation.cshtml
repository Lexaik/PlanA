@model PlanA.Models.Operation


@{
    ViewData["Title"] = "Добавление новой технологической операции";
}

<div class="text-center">
    <form asp-action="CreateOperation" asp-controller="Work">
        <table class="table">
            <tr><th><label asp-for="Name">Наименование</label></th>
                <th><label asp-for="Duration">Длительность</label></th>
                <th></th>
            </tr>
            <tr>
                <td><input type="text" asp-for="Name"/></td>
                <td><input type="text" asp-for="Duration"/></td>
                <td><input type="submit" value="Добавить"/></td>
            </tr>
        </table>
    </form>
</div>