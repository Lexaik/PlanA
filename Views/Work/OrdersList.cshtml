@model List<PlanA.Models.Order>

@{
    ViewBag.Title = "Список заказов";
    Layout = "_Layout";
}

<h2>Список заказов</h2>

<a asp-action="CreateOrder" class="btn btn-success mb-3">
    <i class="bi bi-plus-circle"></i> Создать новый заказ
</a>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Название заказа</th>
            <th>Кол-во позиций</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Name</td>
                <td>@order.OrderItems.Count</td>
                <td>
                    <a asp-action="OrderDetails" asp-route-id="@order.Id" 
                       class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Детали
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        Заказы не найдены. Создайте первый заказ!
    </div>
}
