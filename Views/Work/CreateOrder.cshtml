@model PlanA.Models.Order

@{
    ViewData["Title"] = "Добавление нового заказа";
}

<div class="text-center">
    <form asp-action="CreateOrder" asp-controller="Work">
        <p>
            <label asp-for="Name">Название заказа</label>
            <input type="text" asp-for="Name" />
            <br/>
            <label asp-for="Items">Изделие</label>
            <input type="text" asp-for="Items"/>
            <label asp-for="OrderItems">Количество</label>
            <input type="text" asp-for="OrderItems"/>
        </p>
        <p>
            <input type="submit" value="Сохранить" />
        </p>
    </form>
</div>