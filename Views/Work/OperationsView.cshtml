@model IEnumerable<PlanA.Models.Operation>

@{
    ViewData["Title"] = "Перечень операций";
}

<div class="text-center">
    <p><a asp-action="CreateOperation">Добавить технологическую операцию</a></p>
    <table class="table">
        <tr><th>Название</th>
            <th>Длительность</th>
        </tr>
        
        @foreach (var oper in Model) {
            <tr>
                <td>
                    <a asp-action="EditOperation" asp-route-id="@oper.Id">
                        @oper.Name
                    </a>
                </td>
                <td>@oper.Duration</td>
            </tr>
        }
    </table>
</div>