@model IEnumerable<PlanA.Models.Order>

@{
    ViewData["Title"] = "Список заказов";
}

<div class="text-center">
    <p><a asp-action="CreateOrder">Создать заказ</a></p>
    <table class="table">
        <tr>
            <th>Название</th>
            <th>Дата создания заказа</th>
            <th>Планируемая дата начала</th>
            <th>Фактическая дата начала</th>
            <th>Планируемая дата завершения</th>
            <th>Фактическая дата завершения</th>
            <th>В работе</th>
        </tr>

        @foreach (var order in Model){
            <tr>
                <td>@order.Name</td>
                <td>@order.OrderCreated</td>
                <td>@order.PlanDateStart</td>
                <td>@order.ActualDateStart</td>
                <td>@order.PlanDateEnd</td>
                <td>@order.ActualDateEnd</td>
                <td>@order.IsActive</td>
            </tr>
        }
    </table>
</div>