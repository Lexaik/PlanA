@model PlanA.DTO.OrderDTO;

@{
    ViewData["Title"] = "Список заказов";
}

<input type="hidden" id="tableOrderJson" value='@Json.Serialize(Model.Orders)' />
<input type="hidden" id="availableAssetsJson" value='@Json.Serialize(Model.Assets)' />
<div class="container-fluid py-4 px-4">
    <div class="row">
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0" id="dataTable">
                            <thead class="table-light">
                            <tr>
                                <th class="text-nowrap" style="width: 40px;"></th>
                                <th class="text-nowrap">
                                    <i class="bi bi-person me-1"></i>Название заказа
                                    <span class="filter-indicator" id="orderNameFilterIndicator"></span>
                                </th>
                                <th class="text-nowrap" style="min-width: 300px;">
                                    <i class="bi bi-box me-1"></i>Изделия
                                    <span class="filter-indicator" id="itemFilterIndicator"></span>
                                </th>
                                <th class="text-nowrap">
                                    <i class="bi bi-gear me-1"></i>Действия
                                </th>
                            </tr>
                            </thead>
                            <tbody>
                            <!-- Строка для ввода/редактирования данных -->
                            <tr class="filter-row" id="editRow">
                                <td></td>
                                <td>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           id="editOrderName"
                                           placeholder="Название заказа"
                                           aria-label="Название заказа">
                                </td>
                                <td>
                                    <div class="product-header">
                                        <h6 class="mb-0">Выберите изделия:</h6>
                                        <a href="/products/create" class="btn-add-product btn-sm" target="_blank">
                                            <i class="bi bi-plus-circle"></i>
                                            Новое изделие
                                        </a>
                                    </div>
                                    <div class="multiple-fields-container" id="productContainer">
                                        <!-- Изделия будут добавляться сюда -->
                                    </div>
                                    <button class="btn-add-field btn-sm" onclick="addProductField()">
                                        <i class="bi bi-plus-circle me-1"></i>
                                        Добавить изделие в список
                                    </button>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <button class="btn btn-add btn-sm flex-grow-1" id="mainActionBtn"
                                                onclick="handleMainAction()">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Добавить
                                        </button>
                                        <button class="btn btn-cancel btn-sm" id="cancelBtn" onclick="cancelEditing()"
                                                style="display: none;">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Строки с данными будут добавляться сюда через JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white text-muted small">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="footer-actions">
                            <span>
                                <i class="bi bi-funnel me-1"></i>
                                Всего записей: <span id="totalRecords">0</span>
                            </span>
                            <span>
                                <i class="bi bi-eye me-1"></i>
                                Отображается: <span id="displayedRecords">0</span>
                            </span>
                            <span id="activeFiltersBadge" class="filter-active-badge" style="display: none;">
                                <i class="bi bi-funnel-fill me-1"></i>
                                Фильтры активны
                            </span>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersFooterBtn"
                                onclick="clearAllFilters()" style="display: none;">
                            <i class="bi bi-funnel-x me-1"></i>
                            Сбросить фильтры
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>