@model IEnumerable<PlanA.Models.Order>

@{
    ViewData["Title"] = "Список заказов";
}

<div class="text-center">
    @*<p><a asp-action="CreateOrder">Создать заказ</a></p>*@
    <table class="table">
        <tr><th>Название</th>
            <th>Изделие</th>
            <th>Количество</th>
        </tr>
        <td>
            @*<input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>*@
        </td>
        <tr>
        
        @foreach (var order in Model) {
            bool isFirstRow = true;
            foreach (var order_item in @order.OrderItems) {
                <tr>
                    @if (isFirstRow) {
                        <td rowspan="@order.OrderItems.Count">@order.Name</td>
                        isFirstRow = false;
                    }
                    <td>@order_item.Item.Name</td>
                    <td>@order_item.Quantity</td>
                </tr>
            }
        }
    </table>
</div>