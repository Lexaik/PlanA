@using PlanA.Models
@model IEnumerable<PlanA.Models.Order>

@{
    ViewData["Title"] = "Загрузка производства";
    // В коде C# определяем функцию
    string GetColor(Order order, DateTime today) {
        var stock = "white";
        if (order.ActualDateStart < today && today < order.PlanDateEnd) stock = "yellow";
        return stock;
    }
}

<div class="text-center">
    <table class="table">
        <tr><th>Название</th>
            <th>@DateTime.Now.AddDays(-2).ToString("M")</th>
            <th>@DateTime.Now.AddDays(-1).ToString("M")</th>
            <th>@DateTime.Now.ToString("M")</th>
            <th>@DateTime.Now.AddDays(1).ToString("M")</th>
            <th>@DateTime.Now.AddDays(2).ToString("M")</th>
            <th>@DateTime.Now.AddDays(3).ToString("M")</th>
            <th>@DateTime.Now.AddDays(4).ToString("M")</th>
            <th>@DateTime.Now.AddDays(5).ToString("M")</th>
            <th>@DateTime.Now.AddDays(6).ToString("M")</th>
            <th>@DateTime.Now.AddDays(7).ToString("M")</th>
        </tr>
        @foreach (var order in Model) {
            <tr>
                <td>@order.Name</td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(-2));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(-1));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now);"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(1));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(2));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(3));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(4));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(5));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(6));"></td>
                <td style="background-color: @GetColor(order, DateTime.Now.AddDays(7));"></td>
            </tr>
}
    </table>
</div>