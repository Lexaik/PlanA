@model PlanA.Models.Order

@{
    ViewBag.Title = "Детвли заказа";
    Layout = "_Layout";
}

<h2>Детали заказа #@Model.Id</h2>

<div class="card">
    <div class="card-header">
        <h4>Информация о заказе</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Клиент:</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            
        </dl>
        
        <h5 class="mt-4">Позиции заказа:</h5>
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Товар</th>
                <th>Количество</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.Item?.Name</td>
                    <td>@item.Quantity</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a asp-action="OrdersList" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> К списку заказов
        </a>
        <a asp-action="CreateOrder" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Новый заказ
        </a>
    </div>
</div>